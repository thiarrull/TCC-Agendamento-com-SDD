{
  "name": "sistema-agendamento",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema monolítico de agendamento com Express, EJS e SQLite",
  "main": "src/main/server.js",
  "scripts": {
    "dev": "nodemon src/main/server.js",
    "start": "node src/main/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"public/**/*.{js,css}\" \"eslint.config.js\" \"package.json\" \"README.md\"",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "nodemon": {
      "chokidar": "^4.0.3"
    }
  }
}
